# Copy to .env and fill in the keys you actually use.
# One variable per provider; the selected provider reads its own variable.
HEIYU_API_KEY=YOUR_HEIYU_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
GOOGLE_API_KEY=YOUR_GOOGLE_KEY_HERE
MISTRAL_API_KEY=YOUR_MISTRAL_KEY_HERE
AZURE_OPENAI_API_KEY=YOUR_AZURE_KEY_HERE
# Used only by the generic "openai_compatible" provider.
OCR_API_KEY=YOUR_API_KEY_HERE

# Optional parallelism (defaults shown). 0 removes that limit: all files, all
# candidate pages, or all provider calls at once. Large bursts can exhaust memory
# or trigger provider rate limits, so raise limits gradually.
# FILE_CONCURRENCY=4
# PAGE_CONCURRENCY=4
# OCR_CONCURRENCY=4

# Optional stages (all disabled). Explicit CLI stage flags take precedence.
SEMANTIC_RULES_ENABLED=false
RULES_DATA_PATH=corpus_pipeline/rules/data/rules.json
WRONG_WORDS_PATH=corpus_pipeline/rules/data/wrong_words.tsv
SYNTHESIS_ENABLED=false
SYNTHESIS_MODEL=
SYNTHESIS_LANGUAGE=ar
SYNTHESIS_CONCURRENCY=2
SYNTHESIS_MAX_SAMPLES=10
SYNTHESIS_MAX_ATTEMPTS=2
SYNTHESIS_MAX_TOKENS=2048
# Discover themes with the text model, no manual taxonomy or per-file override:
# use automatic here or select "Automatic themes" in the Synthesis tab.
# CLI default remains legal for compatibility; GUI defaults to automatic.
SYNTHESIS_SCREENING_MODE=legal
TOPIC_SAMPLE_CHARS=12000
TOPIC_MAX_CALLS=100
TOPIC_GROUP_BATCH_SIZE=20
TOPIC_SIMILARITY_THRESHOLD=0.75
GENERAL_CHUNK_CHARS=4000
SCREENING_PATH=corpus_pipeline/synthesis/data/screening.json
MANUAL_OVERRIDES_PATH=
ARTICLE_GROUP_SIZE=3
MIN_ARTICLE_CHARS=40
CORPUS_PROCESSING_ENABLED=false
LANGUAGE_MIXING_THRESHOLD=0.2
DIALECT_BACKEND=lexicon
DIALECT_MODEL_PATH=
DIALECT_LEXICON_PATH=corpus_pipeline/governance/data/lexicon.json
DIALECT_PASS_THRESHOLD=0.2
DIALECT_INTERCEPT_THRESHOLD=0.5
DIALECT_DEGRADED_INTERCEPT_THRESHOLD=0.95
DIALECT_VALIDATED=false
REVIEW_ENABLED=false
REVIEW_LLM_ENABLED=false
REVIEW_MAX_ATTEMPTS=2
STAGE_OUTPUT_DIR=data/training

# Per-document benchmarking (on by default; reference-free metrics are cheap).
# Put corrected transcriptions in the reference folder as <source-stem>.txt to
# enable CER/WER/precision/recall. History and comparisons land in BENCHMARK_DIR.
# BENCHMARK_ENABLED=true
# BENCHMARK_DIR=data/benchmarks
# BENCHMARK_REFERENCE_DIR=data/reference
# BENCHMARK_MAX_EVAL_CHARS=100000
# BENCHMARK_STRIP_DIACRITICS=true
# BENCHMARK_UNIFY_ALEF=false
# BENCHMARK_UNIFY_YA=false
